{
  "name": "@aurea/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API do AUREA — triagem, classificação e painel",
  "main": "dist/servidor.js",
  "scripts": {
    "dev": "tsx watch src/servidor.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "prisma migrate deploy && node dist/servidor.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:banco": "DATABASE_URL=\"mysql://root@localhost:3306/aurea_teste\" PROVA_DE_BANCO=1 vitest run",
    "prova": "node provas/ponta-a-ponta.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aurea/contratos": "workspace:*",
    "@aurea/triagem": "workspace:*",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.3.1",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.5",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
