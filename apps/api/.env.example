# Banco operacional. Dado de paciente REAL só entra aqui depois da aprovação do CEP.
# Até lá, este banco carrega exclusivamente dado sintético.
DATABASE_URL="mysql://root@localhost:3306/aurea_dev"

# Segredo de assinatura do token de sessão. Gere com: openssl rand -hex 32
# Nunca commitar o valor real, nunca reaproveitar entre ambientes.
SEGREDO_DA_SESSAO="troque-este-valor-antes-de-subir-qualquer-ambiente"

# Origens autorizadas a chamar a API, separadas por vírgula.
ORIGENS_PERMITIDAS="http://localhost:3210"

# Fuso do serviço de saúde, não do servidor. Decide o dia do ciclo e o "hoje" do
# painel. Deixar o container em UTC com este valor errado faz check-in noturno
# cair no dia seguinte e desliga cortes de risco com janela de ciclo, em silêncio.
FUSO_HORARIO="America/Sao_Paulo"

# Depois de quantas horas um check-in começado e não terminado vira abandonado.
HORAS_ATE_ABANDONO=6
MINUTOS_ENTRE_MANUTENCOES=15

# Janela em que o mesmo paciente clicando de novo em "falar com a enfermagem"
# reaproveita o pedido aberto. Curta: cobre o clique repetido sem transformar o
# botão em uso único.
MINUTOS_DE_JANELA_DE_CONTATO=30

# Versão do termo de consentimento que vale hoje.
VERSAO_DO_TERMO="demo-0"

PORTA=3333
AMBIENTE=desenvolvimento
